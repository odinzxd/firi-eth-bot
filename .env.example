# Kopier verdiene du vil bruke til en lokal .env-fil.
# Ikke legg .env med API-nøkler eller passord i Git.

# Vanlig botmodus
MARKET=ETHNOK
DRY_RUN=true
MAX_TRADE_NOK=200

# Manuell testhandel fra dashboardet
# Må eksplisitt være true før knappene kan sende ekte ordre.
TEST_TRADING_ENABLED=false
TEST_TRADE_PASSWORD=velg-et-langt-unikt-passord

# Beløpene kan endres uten å endre Python-kode.
# Firi krever minst 10 kr total ordreverdi.
TEST_BUY_NOK=10
TEST_SELL_NOK=10
